<Window x:Class="dvmconsole.SettingsTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Import / Export Settings"
        Width="760"
        Height="680"
        MinWidth="660"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/dvmconsole;component/Assets/config.png"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Settings Transfer" />
            <TextBlock Margin="0,6,0,0"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Text="Choose which settings to export into a portable JSON file, or choose what to import from another console profile. Press Ctrl+A to select all categories and zones." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="1"
                CornerRadius="8"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <ListBox x:Name="CategoryListBox"
                     ItemsSource="{Binding CategoryItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,6">
                            <CheckBox DockPanel.Dock="Left"
                                      Margin="0,1,12,0"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0"
                                           Opacity="0.72"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="8"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                Margin="12,0,0,0">
                        <Button Content="All Zones"
                                Width="92"
                                Height="28"
                                Padding="8,0"
                                Margin="0,0,8,0"
                                Click="SelectAllZones_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Content="No Zones"
                                Width="92"
                                Height="28"
                                Padding="8,0"
                                Click="SelectNoZones_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>

                    <CheckBox x:Name="LimitToZonesCheckBox"
                              Content="Limit transfer to selected zone tabs"
                              FontWeight="SemiBold"
                              IsEnabled="{Binding HasZoneItems}"
                              Checked="LimitToZones_CheckedChanged"
                              Unchecked="LimitToZones_CheckedChanged" />
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,6,0,8"
                           Opacity="0.72"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="{Binding ZoneScopeHint}" />

                <ListBox x:Name="ZoneListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding ZoneItems}"
                         Height="104"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         IsEnabled="{Binding ElementName=LimitToZonesCheckBox, Path=IsChecked}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,3">
                                <CheckBox DockPanel.Dock="Left"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ZoneName}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6"
                   x:Name="StatusTextBlock"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Foreground="#FF2E7D32" />

        <DockPanel Grid.Row="8"
                   LastChildFill="False">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button Content="Select All"
                        Width="96"
                        Height="34"
                        Padding="10,0"
                        Margin="0,0,8,0"
                        Click="SelectAll_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Select None"
                        Width="116"
                        Height="34"
                        Padding="10,0"
                        Click="SelectNone_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button Content="Export Selected"
                        Width="140"
                        Height="34"
                        Padding="10,0"
                        Margin="0,0,8,0"
                        Click="ExportSelected_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Import Selected"
                        Width="140"
                        Height="34"
                        Padding="10,0"
                        Margin="0,0,8,0"
                        Click="ImportSelected_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Close"
                        Width="90"
                        Height="34"
                        Padding="10,0"
                        Click="Close_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
