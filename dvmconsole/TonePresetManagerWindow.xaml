<Window x:Class="dvmconsole.TonePresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tone Presets"
        Width="1040"
        Height="620"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/dvmconsole;component/Assets/page.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Manage Tone Presets" />
            <TextBlock Margin="0,6,0,0"
                       Opacity="0.8"
                       Text="Save single tones, holds, or ordered tone stacks, then send them to a selected resource." />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="1"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <DataGrid x:Name="PresetGrid"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Preset"
                                            Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedPreset.DisplayName, TargetNullValue='Select or add a preset'}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Opacity="0.8"
                                       Text="Target Resource" />
                            <ComboBox ItemsSource="{Binding Targets}"
                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              x:Name="ToneStepGrid"
                              ItemsSource="{Binding SelectedPreset.Steps}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Frequency / Hold"
                                                Binding="{Binding FrequencyDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Duration (sec)"
                                                Binding="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4"
                               LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <Button Content="Add Tone"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="AddTone_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="Add Hold"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="AddHold_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="Delete Step"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="DeleteTone_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="Up"
                                    Width="70"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="MoveToneUp_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="Down"
                                    Width="80"
                                    Height="32"
                                    Click="MoveToneDown_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <Button Content="Send"
                                Width="90"
                                Height="32"
                                DockPanel.Dock="Right"
                                Click="Send_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Foreground="#FF2E7D32"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="6"
                   LastChildFill="False">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button Content="Add Preset"
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="AddPreset_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Delete Preset"
                        Width="120"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="DeletePreset_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Close"
                        Width="90"
                        Height="34"
                        Click="Close_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <Button Content="Save"
                    Width="90"
                    Height="34"
                    DockPanel.Dock="Right"
                    Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </DockPanel>
    </Grid>
</Window>
