<Window x:Class="dvmconsole.EkcPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontSize="13"
        Style="{StaticResource MaterialDesignWindow}" Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Unlock Local Keys" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Enter the password for your EKC container." TextWrapping="Wrap" />
        <TextBlock x:Name="ContainerName" Margin="0,8,0,16" TextWrapping="Wrap" FontWeight="Bold" />
        <PasswordBox x:Name="ContainerPassword" MaxLength="4096" Margin="0,0,0,16"
                     AutomationProperties.Name="EKC password" />
        <TextBlock Text="The password will be remembered using Windows encryption for your account. It is not saved in plain text."
                   TextWrapping="Wrap" />
        <TextBlock Text="Cancel continues without local keys. Reload the codeplug to try again."
                   Margin="0,8,0,16" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Unlock" IsDefault="True" Click="Unlock_Click" />
        </StackPanel>
    </StackPanel>
</Window>

