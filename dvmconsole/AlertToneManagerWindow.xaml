<Window x:Class="dvmconsole.AlertToneManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Alert Tone Manager"
        Width="860"
        Height="500"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/dvmconsole;component/Assets/AppIcon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Manage Custom Alert Tones" />
            <TextBlock Margin="0,6,0,0"
                       Opacity="0.8"
                       Text="Add, remove, and assign custom alert tones to a tab." />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="1"
                CornerRadius="8"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <DataGrid x:Name="AlertToneGrid"
                      ItemsSource="{Binding AlertTones}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      Margin="0"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="180"
                                        IsReadOnly="False" />
                    <DataGridTemplateColumn Header="File"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button Content="Browse"
                                            Width="72"
                                            Height="28"
                                            Margin="0,0,10,0"
                                            DockPanel.Dock="Left"
                                            Click="Browse_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <TextBlock Text="{Binding FilePath}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tab"
                                            Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TabName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AvailableTabs, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding TabName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Foreground="#FF2E7D32"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="6"
                   LastChildFill="False">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button Content="Add"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Add_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Delete"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Delete_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Close"
                        Width="90"
                        Height="34"
                        Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button Content="Save"
                        Width="90"
                        Height="34"
                        Click="Save_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
