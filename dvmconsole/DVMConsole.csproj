      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\configs\codeplug.example.yml;..\configs\alias.example.yml">
      <Link>configs\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Private runtime state is never release content. Examples above are opt-in. -->
    <None Update="codeplugs\**;**\*.ekc;**\*.clear;**\*.log;**\UserSettings.json;**\EkcCredentials\**;**\recordings\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
