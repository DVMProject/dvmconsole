<Window x:Class="dvmconsole.PttKeybindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PTT Keybinds" Width="850" MinWidth="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource MaterialDesignWindow}" Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        PreviewKeyDown="CaptureKey_PreviewKeyDown">
    <StackPanel Margin="24">
        <TextBlock Text="PTT Keybinds" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                   Text="Green follows Ctrl + left-click selection and the existing global PTT fallback. Other slots stay on their assigned resource in this codeplug. Colors are fixed." />
        <StackPanel x:Name="BindingRows" />
        <TextBlock x:Name="CaptureStatus" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Choose Set Key to capture a key. Click to edit an assignment, then click a resource on the console. Esc cancels either picker. Keyboard PTT stays suspended until you leave this editor." />
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                   Text="Grey/off and RX-only resources cannot transmit. Green takes border priority on a Ctrl-click-selected resource. Existing hold/toggle PTT behavior and the transmit timeout still apply." />
        <TextBlock x:Name="ValidationMessage" Foreground="Tomato" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
