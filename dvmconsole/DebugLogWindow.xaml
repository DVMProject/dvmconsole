<Window x:Class="dvmconsole.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Debug Logs"
        Width="900"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/dvmconsole;component/Assets/AppIcon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   LastChildFill="False">
            <TextBlock VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="Live FNECore Debug Logs" />

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <CheckBox x:Name="PauseAutoScrollCheckBox"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Content="Pause Auto-Scroll"
                          Checked="PauseAutoScrollCheckBox_Checked"
                          Unchecked="PauseAutoScrollCheckBox_Unchecked" />

                <Button Content="Clear"
                        Width="90"
                        Height="32"
                        Click="Clear_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2"
                Padding="1"
                CornerRadius="8"
                Background="#FF1C1C1C"
                BorderBrush="#FF4A4A4A"
                BorderThickness="1">
            <TextBox x:Name="LogTextBox"
                     Padding="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#FF1C1C1C"
                     Foreground="#FFF0F0F0"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12"
                     SelectionBrush="#FF3D8BDB" />
        </Border>
    </Grid>
</Window>
