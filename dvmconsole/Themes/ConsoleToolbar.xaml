<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ConsoleToolbarButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ConsoleButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ConsoleButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ConsoleButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ConsoleButtonHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ConsoleIconBlue}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ConsoleButtonPressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ConsoleIconBlue}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConsoleToolbarIcon" TargetType="Control">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Fixed viewports keep the artwork centered and leave room for the strokes at every size. -->
    <ControlTemplate x:Key="ConsoleIcon.Config" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeLineJoin="Round"
                      Data="M6,5 L26,5 26,23 6,23 Z M16,23 V28 M11,28 H21 M10,11 H22 M10,17 H22" />
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M14,10 V12 M20,16 V18" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Ptt" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeLineJoin="Round"
                      Data="M18.5,3 L10,17 H15.5 L13.5,29 23,14 H17 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Alert" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M8,10 C10,4 22,4 24,10 M8,15 C8,21 7,22 6,24 H26 C24,21 24,18 24,16 M15,28 H17" />
                <Path Stroke="{DynamicResource ConsoleIconAmber}" StrokeThickness="2" StrokeLineJoin="Round"
                      Data="M17,18 V11 L22,12.5 V15" />
                <Ellipse Canvas.Left="13" Canvas.Top="16" Width="5" Height="4" Fill="{DynamicResource ConsoleIconAmber}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Page" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Rectangle Canvas.Left="6" Canvas.Top="15" Width="20" Height="13" RadiusX="2" RadiusY="2"
                           Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" />
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M10,20 H17 M10,12 H16" />
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M19,10 C20,8 22,8 23,9 M18,6 C21,3 26,3 28,6" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Select" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M4,10 V4 H10 M22,4 H28 V10 M28,22 V28 H22 M10,28 H4 V22" />
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeLineJoin="Round"
                      Data="M7,7 H14 V14 H7 Z M18,7 H25 V14 H18 Z M7,18 H14 V25 H7 Z M18,18 H25 V25 H18 Z" />
                <Path Stroke="{DynamicResource ConsoleIconGreen}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M10,17 L15,22 24,12" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Key" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{DynamicResource ConsoleIconAmber}" StrokeThickness="2.4" StrokeLineJoin="Round"
                      Data="M14,14 A5.5,5.5 0 1 0 14,18 M14,14 H28 V18 H30 V22 H26 V19 H22 V22 H18 V18 H14 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.History" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M8,26 A12,12 0 1 1 24,26" />
                <Path Fill="{TemplateBinding Foreground}" Data="M6,4 L5,12 12,8 Z" />
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M16,8 V16 L23,20" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Groups" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round"
                      Data="M4,11 H11 V21 H4 Z M21,11 H28 V21 H21 Z M11,16 H21" />
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="3" Data="M13,16 H19" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ConsoleIcon.Audio" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="32" Height="32">
                <Path Fill="{TemplateBinding Foreground}" Data="M3,13 H6 L10,10 V22 L6,19 H3 Z" />
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M13,13 Q15,16 13,19 M19,8 H29 M19,16 H29 M19,24 H29" />
                <Path Stroke="{DynamicResource ConsoleIconBlue}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M23,7 V9 M26,15 V17 M22,23 V25" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
