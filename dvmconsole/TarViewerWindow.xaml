<Window x:Class="dvmconsole.TarViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        x:Name="RootWindow"
        Title="TAR Viewer"
        Width="1120"
        Height="640"
        MinWidth="920"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/dvmconsole;component/Assets/AppIcon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="TAR Recordings" />
                <TextBlock x:Name="FolderPathTextBlock"
                           Margin="0,6,0,0"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="ColumnsButton"
                    Grid.Column="1"
                    Width="100"
                    Height="34"
                    Content="Columns"
                    Click="ColumnsButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ColumnsContextMenu">
                        <MenuItem x:Name="TimeColumnMenuItem" Header="Time" Tag="Time" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="DurationColumnMenuItem" Header="Duration" Tag="Duration" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="ChannelColumnMenuItem" Header="Channel" Tag="Channel" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="TalkgroupColumnMenuItem" Header="Talkgroup" Tag="Talkgroup" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="SourceIdColumnMenuItem" Header="Source ID" Tag="SourceId" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="AliasColumnMenuItem" Header="Alias" Tag="Alias" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="DirectionColumnMenuItem" Header="Direction" Tag="Direction" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="ProtocolColumnMenuItem" Header="Protocol" Tag="Protocol" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="SystemColumnMenuItem" Header="System" Tag="System" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                        <MenuItem x:Name="EncryptionColumnMenuItem" Header="Encryption" Tag="Encryption" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnVisibilityMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Expander Grid.Row="2"
                  Header="Advanced Filters"
                  Background="{DynamicResource MaterialDesignCardBackground}"
                  BorderBrush="{DynamicResource MaterialDesignDivider}"
                  BorderThickness="1"
                  Padding="10,6">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Search" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search all fields" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Direction" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DirectionFilters}"
                              SelectedItem="{Binding SelectedDirectionFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Protocol" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ProtocolFilters}"
                              SelectedItem="{Binding SelectedProtocolFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock Text="Encryption" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding EncryptionFilters}"
                              SelectedItem="{Binding SelectedEncryptionFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="System" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SystemFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Channel" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ChannelFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Talkgroup ID" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TalkgroupFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3">
                    <TextBlock Text="Subscriber ID" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SourceIdFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Alias" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AliasFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Start Date" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding StartDateFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="End Date" Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding EndDateFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="3">
                    <TextBlock Text=" " Opacity="0.72" FontSize="11" Margin="0,0,0,4" />
                    <Button Width="120"
                            HorizontalAlignment="Left"
                            Content="Clear Filters"
                            Click="ClearFilters_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
        </Expander>

        <Border Grid.Row="4"
                Padding="1"
                CornerRadius="8"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <DataGrid x:Name="RecordingsGrid"
                      ItemsSource="{Binding RecordingsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      Margin="0"
                      GridLinesVisibility="Horizontal"
                      ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="TimeColumn"
                                        Header="Time"
                                        Binding="{Binding LocalStartDisplay}"
                                        Width="155" />
                    <DataGridTextColumn x:Name="DurationColumn"
                                        Header="Duration"
                                        Binding="{Binding DurationDisplay}"
                                        Width="90" />
                    <DataGridTextColumn x:Name="ChannelColumn"
                                        Header="Channel"
                                        Binding="{Binding ChannelName}"
                                        Width="190" />
                    <DataGridTextColumn x:Name="TalkgroupColumn"
                                        Header="TG"
                                        Binding="{Binding TalkgroupId}"
                                        Width="90" />
                    <DataGridTextColumn x:Name="SourceIdColumn"
                                        Header="Source ID"
                                        Binding="{Binding SubscriberId}"
                                        Width="90" />
                    <DataGridTextColumn x:Name="AliasColumn"
                                        Header="Alias"
                                        Binding="{Binding SubscriberAlias}"
                                        Width="160" />
                    <DataGridTextColumn x:Name="DirectionColumn"
                                        Header="Dir"
                                        Binding="{Binding Direction}"
                                        Width="60"
                                        Visibility="Collapsed" />
                    <DataGridTextColumn x:Name="ProtocolColumn"
                                        Header="Protocol"
                                        Binding="{Binding Protocol}"
                                        Width="85"
                                        Visibility="Collapsed" />
                    <DataGridTextColumn x:Name="SystemColumn"
                                        Header="System"
                                        Binding="{Binding SystemName}"
                                        Width="140"
                                        Visibility="Collapsed" />
                    <DataGridTextColumn x:Name="EncryptionColumn"
                                        Header="Enc"
                                        Binding="{Binding EncryptionSummary}"
                                        Width="120"
                                        Visibility="Collapsed" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="6"
                   x:Name="StatusTextBlock"
                   Foreground="#FF2E7D32"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="8"
                   LastChildFill="False">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Refresh_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Play"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Play_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Stop"
                        Width="90"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Stop_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Open Folder"
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="OpenFolder_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Delete"
                        Width="90"
                        Height="34"
                        Click="Delete_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button Content="Close"
                        Width="90"
                        Height="34"
                        Click="Close_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
